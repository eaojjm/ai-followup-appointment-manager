    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with due as (\n  select\n    a.id as appointment_id,\n    a.lead_id,\n    l.name,\n    l.telegram_chat_id,\n    a.starts_at,\n    a.ends_at\n  from public.appointments a\n  join public.leads l\n    on l.id = a.lead_id\n  where a.status = 'scheduled'\n    and a.ends_at <= now()\n    and a.outcome_prompt_sent_at is null\n    and (\n      a.outcome_prompt_claimed_at is null\n      or a.outcome_prompt_claimed_at < now() - interval '15 minutes'\n    )\n    and l.telegram_chat_id is not null\n  order by a.ends_at asc\n  for update of a skip locked\n)\nupdate public.appointments a\nset\n  outcome_prompt_claimed_at = now(),\n  updated_at = now()\nfrom due\nwhere a.id = due.appointment_id\nreturning\n  a.id as appointment_id,\n  a.lead_id,\n  due.name,\n  due.telegram_chat_id,\n  a.starts_at,\n  a.ends_at,\n  a.outcome_prompt_claimed_at,\n  to_char(\n    a.starts_at at time zone 'Asia/Barnaul',\n    'DD.MM.YYYY'\n  ) as local_date,\n  to_char(\n    a.starts_at at time zone 'Asia/Barnaul',\n    'HH24:MI'\n  ) as local_start_time;",
        "options": {}
