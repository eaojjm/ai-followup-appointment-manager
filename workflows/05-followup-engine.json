        "chatId": "={{ $env.MANAGER_TELEGRAM_CHAT_ID }}",
        "text": "={{ \n\"🟡 Новый follow-up на согласование\\n\\n\" +\n\"Клиент: \" + $('Get Due Follow-ups').item.json.name + \"\\n\\n\" +\n\"Сообщение клиенту:\\n\" + $json.text\n}}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "✅ Отправить",
                    "additionalFields": {
                      "callback_data": "={{ 'send|' + $json.id + '|' + $json.pending_followup_version }}"
                    }
                  },
                  {
                    "text": "⏰ Отложить",
                    "additionalFields": {
                      "callback_data": "={{ 'delay|' + $json.id + '|' + $json.pending_followup_version }}"
                    }
                  },
                  {
                    "text": "❌ Закрыть",
                    "additionalFields": {
                      "callback_data": "={{ 'close|' + $json.id + '|' + $json.pending_followup_version }}"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "appendAttribution": false
        }
      },
