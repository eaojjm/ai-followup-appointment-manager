# Illustrative settings for your own isolated self-hosted n8n deployment.
# This file does not configure n8n credentials or Docker by itself.
# Never commit a filled .env file.
TELEGRAM_BOT_TOKEN=
MANAGER_TELEGRAM_CHAT_ID=
# OpenAI and PostgreSQL access are configured in n8n Credentials, not here.
# $env access depends on your n8n deployment policy. See docs/SETUP.md.
