{
  "name": "Appointment Lifecycle",
  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with due as (\n  select\n    a.id as appointment_id,\n    a.lead_id,\n    l.name,\n    l.telegram_chat_id,\n    a.starts_at,\n    a.ends_at\n  from public.appointments a\n  join public.leads l\n    on l.id = a.lead_id\n  where a.status = 'scheduled'\n    and a.reminder_24h_sent_at is null\n    and (\n      a.reminder_24h_claimed_at is null\n      or a.reminder_24h_claimed_at < now() - interval '15 minutes'\n    )\n    and a.starts_at > now()\n    and a.starts_at <= now() + interval '24 hours'\n    and l.telegram_chat_id is not null\n  order by a.starts_at asc\n  for update of a skip locked\n)\nupdate public.appointments a\nset\n  reminder_24h_claimed_at = now(),\n  updated_at = now()\nfrom due\nwhere a.id = due.appointment_id\nreturning\n  a.id as appointment_id,\n  a.lead_id,\n  due.name,\n  due.telegram_chat_id,\n  a.starts_at,\n  a.ends_at,\n  a.reminder_24h_claimed_at,\n  to_char(\n    a.starts_at at time zone 'Asia/Barnaul',\n    'DD.MM.YYYY'\n  ) as local_date,\n  to_char(\n    a.starts_at at time zone 'Asia/Barnaul',\n    'HH24:MI'\n  ) as local_start_time;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        400,
        2256
      ],
      "id": "04a4d4b2-5482-5b2c-a5c6-7b61f1d009a3",
      "name": "Get Due Appointment Reminders"
    },
    {
      "parameters": {
        "chatId": "={{ $json.telegram_chat_id }}",
        "text": "={{ 'Напоминаем о вашей записи.\\n\\n' + 'Дата: ' + $json.local_date + '\\n' + 'Время: ' + $json.local_start_time }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        960,
        2256
      ],
      "id": "5441b978-8ba5-5d69-8bd3-d1f8859fba67",
