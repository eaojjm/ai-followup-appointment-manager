      "position": [
        -160,
        144
      ],
      "typeVersion": 1.2
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select *\nfrom public.leads\nwhere status = 'active'\n  and next_followup_at <= now()\n  and followup_count < 3\n  and pending_followup_text is null\n  and pending_followup_created_at is null\n  and pending_followup_status is null;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        64,
        144
      ],
      "id": "01474670-9ce5-5855-9561-28e5cbf0bc39",
      "name": "Get Due Follow-ups"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-5-mini",
          "mode": "list"
        },
        "options": {}
      },
      "id": "739e3d70-377a-550e-9e81-f7c3e9d41392",
      "name": "OpenAI Follow Up",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        304,
        352
      ],
      "typeVersion": 1.2
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Имя клиента:\n{{ $json.name }}\n\nКоличество уже отправленных follow-up:\n{{ $json.followup_count }}\n\nКонтекст предыдущего общения:\n{{ $json.conversation_summary }}\n\nСгенерируй следующий follow-up согласно этапу.",
        "messages": {
          "messageValues": [
            {
              "message": "=Ты помощник менеджера по продажам.\n\nТвоя задача - писать короткие персонализированные follow-up сообщения клиентам, которые перестали отвечать.\n\nИспользуй только предоставленный контекст.\nНе придумывай услуги, предложения, материалы, скидки, встречи или другие возможности, которых нет в контексте.\nНе добавляй выгоды, эффекты, обещания или выводы, если они прямо не следуют из контекста.\nНе предлагай созвон, встречу, демонстрацию, материалы или другой конкретный следующий шаг, если он прямо не указан в контексте.\nЕсли следующий шаг не указан, просто уточни, актуальна ли тема и хочет ли клиент продолжить диалог.\n\nСтиль:\n- естественный;\n- короткий;\n- без давления;\n- без канцелярита;\n- без упоминания AI;\n- максимум 3-4 коротких предложения.\n\nЭтап зависит от followup_count:\n\n0 - первое мягкое напоминание и попытка вернуть клиента в диалог.\n1 - второе касание: кратко напомни ценность обсуждаемой темы и уточни, актуален ли вопрос.\n2 - финальное касание: вежливо сообщи, что больше беспокоить не будешь, но клиент может вернуться к разговору позже.\n\nВыводи только готовое сообщение клиенту."
            }
          ]
        },
        "batching": {}
      },
      "id": "7c238078-febe-5717-b052-0b56607389b0",
      "name": "Generate Follow-up",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        304,
        144
      ],
      "typeVersion": 1.7
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update public.leads\nset\n  pending_followup_text = $1,\n  pending_followup_created_at = now(),\n  pending_followup_status = 'pending',\n  pending_followup_version = pending_followup_version + 1,\n  updated_at = now()\nwhere id = $2::uuid\n  and status = 'active'\n  and next_followup_at <= now()\n  and followup_count < 3\n  and pending_followup_text is null\n  and pending_followup_created_at is null\n  and pending_followup_status is null\nreturning\n  id,\n  name,\n  pending_followup_text as text,\n  pending_followup_created_at,\n  pending_followup_status,\n  pending_followup_version;",
        "options": {
          "queryReplacement": "={{ [$json.text, $('Get Due Follow-ups').item.json.id] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        752,
        144
      ],
      "id": "60bfe3d7-f45b-59db-82eb-73a7376059be",
      "name": "Save Follow-up Draft"
    },
    {
