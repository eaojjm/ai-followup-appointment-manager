    {
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into public.conversation_messages (\n  lead_id,\n  handoff_id,\n  sender_type,\n  recipient_type,\n  message_type,\n  text,\n  telegram_chat_id,\n  telegram_message_id\n)\nvalues (\n  $1::uuid,\n\n  (\n    select hs.id\n    from public.handoff_sessions hs\n    where hs.lead_id = $1::uuid\n      and hs.status = 'open'\n    order by hs.created_at desc\n    limit 1\n  ),\n\n  'bot',\n  'client',\n  'message',\n  $2,\n  $3::bigint,\n  $4::bigint\n)\non conflict (telegram_chat_id, telegram_message_id)\nwhere telegram_chat_id is not null\n  and telegram_message_id is not null\ndo nothing\nreturning id;",
        "options": {
          "queryReplacement": "={{ [   $json.lead_id,   $json.text,   $json.chat_id,   $json.telegram_message_id ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
