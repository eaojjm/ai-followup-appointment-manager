        "query": "update public.appointments\nset\n  reminder_24h_sent_at = now(),\n  reminder_24h_claimed_at = null,\n  updated_at = now()\nwhere id = $1::uuid\n  and status = 'scheduled'\n  and reminder_24h_sent_at is null\n  and reminder_24h_claimed_at is not null\nreturning\n  id,\n  reminder_24h_sent_at;",
        "options": {
          "queryReplacement": "={{ [$('Get Due Appointment Reminders').item.json.appointment_id] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
